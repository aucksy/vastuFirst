<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      ⭐ The app's ONLY permission, and it arrived with "scan your plan" (v0.3.16).

      Everything else in VastuFirst is computed on the device: drawing, the engine, the score, the
      report, saved homes. Reading an uploaded plan is the single feature that talks to a server, it
      asks the user first, and refusing it still gets a full score — the guided grid is judged by the
      same rules. (Not the SAME NUMBER: the grid asks a missing-corner question the scan path never
      asks, so shape faults can differ. Do not restore "the same score" wording anywhere.)

      Without this line every read fails with a SecurityException, the reader reports "we couldn't
      read your plan just now", and the feature looks broken in a way no compiler and no unit test
      would ever mention. scripts/check-manifest.sh fails the build if it goes missing again.

      Note what is NOT here: no camera permission, no storage permission, no location, no
      network-state.

      ⭐ "Take a photo" (v0.6.6) STILL needs no camera permission, and that is not an accident. We
      hand the job to the phone's own camera app and it hands back the picture — the camera is never
      opened by us. Android only demands the CAMERA grant from an app that DECLARES it, so declaring
      it "to be safe" would create the very permission prompt this app has never needed.
      scripts/check-manifest.sh fails the build if that line ever appears.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      ⭐ NO BACKUPS (14 Oct 2026). The privacy policy and the in-app privacy screen say every home is
      "saved only on this device" and that Delete all my data removes it. With allowBackup="true" that
      was false: Android copied the homes database, the plan photos, the consent setting and the crash
      note to the user's Google Drive, and put them back after a reinstall. allowBackup="false" stops
      the cloud copy on Android 6-11; on 12 and later, data_extraction_rules.xml also stops the copy
      to a NEW PHONE (device transfer), which allowBackup alone does not.
    -->
    <application
        android:name=".VastuApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:theme="@style/Theme.VastuFirst">

        <!--
          The activity starts in Theme.VastuFirst.Starting — the splash — and switches itself to
          Theme.VastuFirst on creation (see MainActivity). The application-level theme above stays
          the plain one, so nothing else that inherits it shows a splash.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.VastuFirst.Starting"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The one folder the phone's camera app is allowed to write into, so "take a photo" can hand
          the picture back. Not exported: the grant is a one-shot permission on a single file, given
          to the camera app for the length of one capture and to nothing else. See res/xml/file_paths.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
