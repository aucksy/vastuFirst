<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and later. Nothing leaves the phone: no cloud backup and no copy to a new phone. Homes,
  plan photos and settings are "saved only on this device" (privacy policy) and this file keeps that
  true. See the comment on <application> in AndroidManifest.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
