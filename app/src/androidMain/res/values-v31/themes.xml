<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+ draws a system splash screen; point it at the brand mark on paper so the launch
         is continuous with the Welcome screen instead of a white flash. -->
    <style name="Theme.VastuFirst" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
