<?xml version="1.0" encoding="utf-8"?>
<!--
  The VastuFirst mark, identical in geometry to designsystem BrandMark.kt: a mandala square with
  its 3x3 grid, the North arrow, and the gold Brahmasthan dot.

  BrandMark draws on a 40-unit grid. Adaptive-icon foregrounds are 108x108 with only the central
  72x72 guaranteed visible after masking, so the 40-unit design is scaled x1.65 and centred:
      x' = 21 + x * 1.65      (36-unit square -> 59.4 units, well inside the safe zone)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Centre tile tint (Brahmasthan cell) -->
    <path
        android:fillColor="#7A9E7E"
        android:fillAlpha="0.18"
        android:pathData="M44.1,44.1 L63.9,44.1 L63.9,63.9 L44.1,63.9 Z" />

    <!-- Outer rounded square -->
    <path
        android:strokeColor="#DDDED3"
        android:strokeWidth="2.31"
        android:fillColor="@android:color/transparent"
        android:pathData="M30.9,24.3 L77.1,24.3 A6.6,6.6 0 0 1 83.7,30.9 L83.7,77.1 A6.6,6.6 0 0 1 77.1,83.7 L30.9,83.7 A6.6,6.6 0 0 1 24.3,77.1 L24.3,30.9 A6.6,6.6 0 0 1 30.9,24.3 Z" />

    <!-- 3x3 grid -->
    <path
        android:strokeColor="#DDDED3"
        android:strokeWidth="1.32"
        android:pathData="M44.1,24.3 L44.1,83.7 M63.9,24.3 L63.9,83.7 M24.3,44.1 L83.7,44.1 M24.3,63.9 L83.7,63.9" />

    <!-- North arrow -->
    <path
        android:fillColor="#7A9E7E"
        android:pathData="M54,29.25 L59.61,46.74 L54,43.11 L48.39,46.74 Z" />

    <!-- Gold Brahmasthan dot -->
    <path
        android:fillColor="#C9A227"
        android:pathData="M49.71,54 A4.29,4.29 0 1 1 58.29,54 A4.29,4.29 0 1 1 49.71,54 Z" />
</vector>
